# Copy to .env.local for local development. Never commit real credentials.
ZHIHU_ACCESS_SECRET=
ZHIHU_MODEL=zhida-fast-1p5

# App-side attempt caps; these are not official Zhihu account quotas.
# Reset daily at 00:00 Asia/Shanghai. Failed upstream attempts also count.
ZHIHU_DAILY_CALL_LIMIT=120
ZHIHU_VISITOR_DAILY_CALL_LIMIT=20
ZHIHU_VISITOR_MINUTE_CALL_LIMIT=6
ZHIHU_MAX_CONCURRENT_CALLS=2
